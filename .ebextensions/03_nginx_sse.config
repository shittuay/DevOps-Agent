files:
  "/etc/nginx/conf.d/proxy_sse.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Keep SSE connections open — default 60s kills long-running streams
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;
      # Disable response buffering so SSE events reach the client immediately
      proxy_buffering off;
