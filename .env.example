# ========================================
# DevOps Agent - Environment Configuration
# ========================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# ========================================
# REQUIRED
# ========================================

# Anthropic API Key (Get from: https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Flask Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Database URL
DATABASE_URL=sqlite:///devops_agent.db

# ========================================
# CLOUD PROVIDERS (Choose what you use)
# ========================================

# AWS Credentials
# Get from: AWS Console → IAM → Users → Create User
# AWS_ACCESS_KEY_ID=AKIAXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_DEFAULT_REGION=us-east-1

# Google Cloud Platform
# Get from: GCP Console → IAM → Service Accounts → Create Key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# GCP_PROJECT_ID=your-project-id

# Microsoft Azure
# Get from: Azure Portal → App Registrations → Create Service Principal
# AZURE_CLIENT_ID=xxxxx
# AZURE_CLIENT_SECRET=xxxxx
# AZURE_TENANT_ID=xxxxx
# AZURE_SUBSCRIPTION_ID=xxxxx

# ========================================
# CI/CD & VERSION CONTROL
# ========================================

# GitHub Personal Access Token
# Get from: GitHub → Settings → Developer settings → Personal access tokens
# Scopes needed: repo, workflow, admin:org
# GITHUB_TOKEN=ghp_xxxxx

# GitLab Personal Access Token
# Get from: GitLab → Preferences → Access Tokens
# GITLAB_TOKEN=xxxxx
# GITLAB_URL=https://gitlab.com

# Jenkins
# JENKINS_URL=https://jenkins.example.com
# JENKINS_USER=your-username
# JENKINS_TOKEN=xxxxx

# ========================================
# KUBERNETES
# ========================================

# Kubernetes Config (Optional - uses ~/.kube/config by default)
# KUBECONFIG=/path/to/kubeconfig

# ========================================
# PAYMENT PROCESSING (Optional)
# ========================================

# Stripe Keys (Get from: https://dashboard.stripe.com/apikeys)
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ========================================
# MONITORING & OBSERVABILITY (Optional)
# ========================================

# Datadog
# DATADOG_API_KEY=xxxxx
# DATADOG_APP_KEY=xxxxx

# New Relic
# NEW_RELIC_LICENSE_KEY=xxxxx

# Prometheus
# PROMETHEUS_URL=http://localhost:9090

# ========================================
# EMAIL & NOTIFICATIONS (Optional)
# ========================================

# SMTP for Email Notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=DevOps Agent <noreply@yourcompany.com>

# Slack Webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx

# ========================================
# SECURITY & SECRETS MANAGEMENT (Optional)
# ========================================

# HashiCorp Vault
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=xxxxx

# AWS Secrets Manager
# AWS_SECRETS_REGION=us-east-1

# ========================================
# ADVANCED CONFIGURATION (Optional)
# ========================================

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Max API Retries
MAX_API_RETRIES=3

# Command Timeout (seconds)
COMMAND_TIMEOUT=1800

# Enable Debug Mode (True/False)
DEBUG=False

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_STORAGE=memory://

# ========================================
# NOTES
# ========================================

# Security Best Practices:
# 1. Never commit this file to git
# 2. Use least privilege - grant only necessary permissions
# 3. Rotate credentials every 90 days
# 4. Use service accounts instead of personal accounts
# 5. Enable MFA on all cloud accounts
# 6. Monitor usage and set billing alerts

# Quick Setup (Minimum to get started):
# 1. Set ANTHROPIC_API_KEY
# 2. Set SECRET_KEY (generate a random one)
# 3. Configure at least one cloud provider (AWS recommended)
# 4. Restart Flask: python app.py
# 5. Visit: http://localhost:5000

# Get Help:
# - Read: CREDENTIALS_SETUP_GUIDE.md
# - Check logs: logs/agent.log
# - Test connections before using in production
