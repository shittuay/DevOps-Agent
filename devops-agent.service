[Unit]
Description=DevOps Agent Gunicorn Service
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/devops-agent
Environment="PATH=/var/www/devops-agent/venv/bin"
Environment="PROMETHEUS_MULTIPROC_DIR=/var/www/devops-agent/prometheus_multiproc"
EnvironmentFile=/var/www/devops-agent/.env
# Multiprocess Prometheus metrics require this directory empty at startup —
# stale files from a previous run's PID would otherwise be misread as a live
# worker's counters. See services/metrics_service.py and gunicorn.conf.py.
ExecStartPre=/bin/rm -rf /var/www/devops-agent/prometheus_multiproc
ExecStartPre=/bin/mkdir -p /var/www/devops-agent/prometheus_multiproc
ExecStart=/var/www/devops-agent/venv/bin/gunicorn \
  --config /var/www/devops-agent/gunicorn.conf.py \
  --worker-class gthread \
  --workers 3 \
  --threads 8 \
  --bind 127.0.0.1:8000 \
  --timeout 900 \
  --graceful-timeout 300 \
  --keep-alive 5 \
  --log-level info \
  --access-logfile /var/log/devops-agent-access.log \
  --error-logfile /var/log/devops-agent-error.log \
  app:app
Restart=always
RestartSec=10
# A deploy must not guillotine an agent turn that is already changing real cloud
# infrastructure. gunicorn is given --graceful-timeout 300 to drain in-flight
# turns; systemd has to out-wait that or it SIGKILLs mid-drain (which is exactly
# what truncated a workflow run on 2026-08-13 — see CLAUDE_RUNBOOK.md).
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
