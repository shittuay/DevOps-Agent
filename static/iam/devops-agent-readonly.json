{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ComputeContainersRead",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetConsoleOutput",
        "autoscaling:Describe*",
        "eks:Describe*",
        "eks:List*",
        "ecs:Describe*",
        "ecs:List*",
        "lambda:List*",
        "lambda:GetAccountSettings",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "elasticloadbalancing:Describe*",
        "elasticbeanstalk:Describe*",
        "elasticbeanstalk:List*",
        "states:Describe*",
        "states:List*",
        "ecr:Describe*",
        "ecr:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataStoresMetadataRead",
      "Effect": "Allow",
      "Action": [
        "rds:Describe*",
        "rds:ListTagsForResource",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "elasticache:Describe*",
        "elasticfilesystem:Describe*",
        "redshift:Describe*",
        "es:Describe*",
        "es:List*",
        "kafka:Describe*",
        "kafka:List*",
        "kinesis:Describe*",
        "kinesis:List*",
        "glue:Get*",
        "glue:List*",
        "athena:List*",
        "athena:GetWorkGroup",
        "backup:Describe*",
        "backup:List*",
        "backup:GetBackupPlan",
        "s3:ListAllMyBuckets",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketAcl",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NetworkingEdgeRead",
      "Effect": "Allow",
      "Action": [
        "route53:Get*",
        "route53:List*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "acm:Describe*",
        "acm:List*",
        "apigateway:GET",
        "appsync:Get*",
        "appsync:List*",
        "wafv2:Get*",
        "wafv2:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityGovernanceRead",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*",
        "iam:GenerateCredentialReport",
        "iam:GenerateServiceLastAccessedDetails",
        "sts:GetCallerIdentity",
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:LookupEvents",
        "config:Describe*",
        "config:Get*",
        "config:List*",
        "organizations:Describe*",
        "organizations:List*",
        "secretsmanager:ListSecrets",
        "secretsmanager:DescribeSecret",
        "ssm:Describe*",
        "servicequotas:Get*",
        "servicequotas:List*",
        "servicecatalog:Describe*",
        "servicecatalog:List*",
        "codeartifact:Describe*",
        "codeartifact:List*",
        "bedrock:Get*",
        "bedrock:List*",
        "sagemaker:Describe*",
        "sagemaker:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ObservabilityCostRead",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "logs:Describe*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "ce:Get*",
        "ce:Describe*",
        "ce:List*",
        "xray:Get*",
        "xray:BatchGet*",
        "support:Describe*",
        "resource-groups:Get*",
        "resource-groups:List*",
        "resource-groups:SearchResources",
        "tag:Get*",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "events:Describe*",
        "events:List*",
        "sns:Get*",
        "sns:List*",
        "sqs:Get*",
        "sqs:List*"
      ],
      "Resource": "*"
    }
  ]
}
