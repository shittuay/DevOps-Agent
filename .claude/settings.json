{
  "permissions": {
    "allow": [
      "Bash(python app.py *)",
      "Bash(python main.py *)",
      "Bash(pytest *)",
      "Bash(pip install *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Read(*)",
      "Write(*.py)",
      "Write(*.html)",
      "Write(*.js)",
      "Write(*.css)",
      "Write(*.md)",
      "Write(*.json)",
      "Write(*.yaml)",
      "Write(*.yml)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DELETE FROM*WHERE 1=1*)",
      "Bash(*password*)",
      "Bash(*secret*)",
      "Write(*.env)",
      "Write(*credentials*)"
    ],
    "ask": [
      "Bash(pip uninstall *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(*migrate*)",
      "Bash(*production*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/security_check.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/audit_log.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/docs_update_check.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "aws-serverless@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true
  }
}
