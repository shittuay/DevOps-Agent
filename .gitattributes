# Force LF line endings for all text files (project deploys to Linux)
* text=auto eol=lf

# Explicitly LF for source files
*.py    text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.env.example text eol=lf

# Binary files — no conversion
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.db    binary
